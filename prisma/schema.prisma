generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model user {
  id              String        @id@default(uuid())
  name            String
  email           String        @unique
  password        String
  isEmailVerified Boolean  @default(false)
  verificationToken String?
  age             Int?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}
